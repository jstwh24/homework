# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并修改密码
#
# ⚠️ 重要：只需修改下面的密码即可，init.sh 会自动从 MYSQL_PASSWORD
#    读取密码来初始化数据库用户，不会出现密码不一致的问题。
# ============================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=game_db
MYSQL_USER=game_user
MYSQL_PASSWORD=your_game_password_here

# 数据库连接配置（游戏服务使用）
# DB_PASSWORD 必须与上面的 MYSQL_PASSWORD 一致
DB_HOST=mysql-game
DB_PORT=3306
DB_USER=game_user
DB_PASSWORD=your_game_password_here
DB_NAME=game_db

# Flask 配置
FLASK_SECRET_KEY=your_secret_key_here_change_in_production
FLASK_ENV=production
